// BlockFlip — Prisma 7 schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum Role {
  INVESTOR
  SPECIALIST
}

enum PoolStatus {
  PENDING    // Awaiting specialist skin-in-the-game on-chain
  ACTIVE     // Fundraising open
  FUNDED     // Target reached
  LIQUIDATED // Cycle closed, yields distributed
}

enum OperationType {
  AUCTION         // Arremate (leilão) — acquisition price is a ceiling bid
  DIRECT_PURCHASE // Compra direta — acquisition price is fixed/negotiated
}

// ─── Models ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())

  // Hybrid auth: wallet-only, email-only, or both
  email         String?  @unique
  passwordHash  String?
  walletAddress String?  @unique

  role      Role     @default(INVESTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investments  Investment[]
  poolsCreated Pool[]       @relation("SpecialistPools")
}

model Pool {
  id String @id @default(uuid())

  // On-chain identifiers
  poolPda     String @unique
  mintAddress String @unique

  // Off-chain metadata
  name        String
  description String?
  imageUrl    String? // Must pass isAllowedImageUrl() before storing
  location    String?
  cycleDays   Int?

  // Operation type — drives UI copy and ROI scenario interpretation
  operationType OperationType @default(DIRECT_PURCHASE)

  // Cost breakdown (validated at action layer: acquisitionCost + renovationCost + legalCost = targetCapital)
  // For AUCTION: acquisitionCost is the ceiling bid (worst-case scenario)
  // For DIRECT_PURCHASE: acquisitionCost is the fixed negotiated price
  acquisitionCost Float? // Arremate ceiling OR compra direta value
  renovationCost  Float? // Estimated renovation (Capex)
  legalCost       Float? // Docs, taxes, legal fees

  // Financials (in USDC)
  targetCapital Float      // Sum of the three costs above — authoritative fundraising target
  raisedCapital Float      @default(0)
  skinInGame    Float      @default(0)

  // ROI projection
  // AUCTION:         conservative = bought at ceiling, optimistic = bought at floor
  // DIRECT_PURCHASE: conservative/optimistic driven by sale price uncertainty
  roiConservative Float
  roiBase         Float
  roiOptimistic   Float

  status    PoolStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  specialistId String
  specialist   User         @relation("SpecialistPools", fields: [specialistId], references: [id])
  investments  Investment[]
}

model Investment {
  id        String   @id @default(uuid())
  amount    Float // USDC
  txHash    String   @unique
  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
}
